---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import TelegramCTA from '../components/TelegramCTA.astro';
import { getPublishedPosts, coverClara } from '../lib/posts';
import { getOfertas, type Oferta } from '../lib/ofertas';

const posts = (await getPublishedPosts()).slice(0, 3);

let produtosDestaque: Oferta[] = [];
try {
  produtosDestaque = (await getOfertas()).slice(0, 8);
} catch {
  produtosDestaque = [];
}

const guias = [
  { titulo: 'Como Escolher uma Placa de Vídeo', href: '/funis/placa-de-video', resumo: 'VRAM, resolução e ray tracing por faixa de orçamento.' },
  { titulo: 'Como Escolher um Processador', href: '/funis/processador', resumo: 'Núcleos, TDP e compatibilidade de soquete explicados.' },
  { titulo: 'Como Escolher uma Placa-Mãe', href: '/funis/placa-mae', resumo: 'Soquete, chipset, tamanho e VRM explicados.' },
  { titulo: 'Como Escolher um Monitor Gamer', href: '/funis/monitores-gamer', resumo: 'Taxa de atualização, painel e resolução explicados.' },
  { titulo: 'Melhores Mouses Gamer', href: '/funis/mouses-gamer', resumo: 'Comparativo por sensor, DPI e faixa de preço.' },
];
---
<BaseLayout
  title="Tecnologia, hardware e as melhores ofertas"
  description="Noticias, guias de compra e as melhores ofertas de hardware e tecnologia, com curadoria diaria no canal do Telegram."
>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 pt-16 pb-14 text-center">
    <p class="text-brand-2 font-semibold tracking-wide uppercase text-sm mb-3">Hardware · Tecnologia · Ofertas</p>
    <h1 class="text-4xl sm:text-5xl font-extrabold text-text leading-tight max-w-3xl mx-auto">
      Entenda tecnologia e nunca mais pague caro por hardware
    </h1>
    <p class="text-muted text-lg mt-5 max-w-2xl mx-auto">
      Guias de compra e curadoria diária de ofertas em monitores, placas de vídeo, processadores
      e periféricos — com critérios claros de qualidade e confiabilidade.
    </p>
    <div class="mt-8 flex justify-center">
      <TelegramCTA variant="banner" texto="Receba as ofertas assim que elas saem, direto no Telegram." />
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="text-2xl font-bold text-text">Ofertas recentes no canal</h2>
      <a href="https://t.me/int3ch" target="_blank" rel="noopener" class="text-brand-2 text-sm font-semibold hover:text-brand transition-colors">Ver todas →</a>
    </div>
    {produtosDestaque.length === 0 ? (
      <div class="rounded-2xl border border-line bg-panel p-8 text-center text-muted">
        Nenhuma oferta disponível no momento. Confira o
        <a href="https://t.me/int3ch" target="_blank" rel="noopener" class="text-brand-2 hover:text-brand transition-colors"> canal no Telegram</a>.
      </div>
    ) : (
      <div class="grid grid-cols-2 sm:grid-cols-4 auto-rows-[150px] sm:auto-rows-[170px] gap-5">
        {produtosDestaque.map((p, i) => {
          const grande = i === 0;
          const alta = i === 3;
          return (
            <a href={p.link} target="_blank" rel="noopener sponsored"
               class:list={[
                 'group relative rounded-2xl border border-line bg-panel overflow-hidden',
                 'hover:border-brand/50 hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-2/10 transition-all duration-300',
                 grande && 'col-span-2 row-span-2',
                 alta && 'row-span-2',
               ]}>
              {p.imagem ? (
                <img src={p.imagem} alt={p.titulo} loading="lazy" referrerpolicy="no-referrer" class="absolute inset-0 w-full h-full object-cover"
                     onerror="this.closest('a').querySelector('.img-fallback').hidden=false; this.remove()" />
              ) : null}
              <div class="img-fallback absolute inset-0 flex items-center justify-center text-muted text-xs px-2 text-center bg-panel-2" hidden={!!p.imagem}>
                Imagem indisponível
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/10 to-transparent" />
              {p.desconto ? (
                <span class="absolute top-2.5 left-2.5 rounded-full bg-gradient-to-r from-brand to-brand-2 text-black text-xs font-bold px-2.5 py-1">
                  -{p.desconto}%
                </span>
              ) : null}
              <p class="absolute bottom-0 left-0 right-0 text-xs text-white/90 p-3 line-clamp-2 group-hover:text-white transition-colors">
                {p.titulo}
              </p>
            </a>
          );
        })}
      </div>
    )}
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="text-2xl font-bold text-text">Guias de compra</h2>
    </div>
    <div class="grid sm:grid-cols-2 gap-5">
      {guias.map((g) => (
        <a href={g.href} class="group rounded-2xl border border-line bg-panel p-6 hover:border-brand/50 hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-2/10 transition-all duration-300">
          <h3 class="text-lg font-bold text-text group-hover:text-brand-2 transition-colors">{g.titulo}</h3>
          <p class="text-muted text-sm mt-2">{g.resumo}</p>
          <span class="text-brand-2 text-sm font-semibold mt-4 inline-block">Ver guia →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="text-2xl font-bold text-text">Últimos artigos</h2>
      <a href="/blog" class="text-brand-2 text-sm font-semibold hover:text-brand transition-colors">Ver todos →</a>
    </div>
    <div class="grid sm:grid-cols-3 gap-5">
      {posts.map((post) => (
        <a href={`/blog/${post.id}`} class="group rounded-2xl border border-line bg-panel overflow-hidden hover:border-brand/50 hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-2/10 transition-all duration-300">
          {post.data.cover && (
            <div class="aspect-[16/9] bg-panel-2 overflow-hidden">
              <img src={post.data.cover} alt="" loading="lazy" class="cover-dark w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <img src={coverClara(post.data.cover)} alt="" loading="lazy" class="cover-light w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
          )}
          <div class="p-5">
            <p class="text-xs text-muted mb-2">{post.data.pubDate.toLocaleDateString('pt-BR')}</p>
            <h3 class="font-bold text-text group-hover:text-brand-2 transition-colors leading-snug">{post.data.title}</h3>
            <p class="text-muted text-sm mt-2 line-clamp-3">{post.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
