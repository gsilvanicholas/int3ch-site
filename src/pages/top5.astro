---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TelegramCTA from '../components/TelegramCTA.astro';
import { getOfertas, type Oferta } from '../lib/ofertas';

let top5: Oferta[] = [];
try {
  const ofertas = await getOfertas();
  top5 = ofertas
    .filter((o) => typeof o.desconto === 'number')
    .sort((a, b) => (b.desconto ?? 0) - (a.desconto ?? 0))
    .slice(0, 5);
} catch {
  top5 = [];
}

const medalhas = ['🥇', '🥈', '🥉', '4º', '5º'];
---
<BaseLayout
  title="Top 5 da Semana"
  description="As 5 ofertas com maior desconto disponiveis agora, atualizadas automaticamente conforme o canal publica."
>
  <Breadcrumbs itens={[{ nome: 'Início', href: '/' }, { nome: 'Top 5 da Semana' }]} />
  <section class="max-w-3xl mx-auto px-4 sm:px-6 pt-6 pb-14">
    <p class="text-brand-2 font-semibold uppercase text-sm tracking-wide mb-3">Atualizado automaticamente</p>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text leading-tight">Top 5 da Semana</h1>
    <p class="text-muted text-lg mt-4">
      As 5 ofertas com o maior desconto disponíveis agora entre tudo que passou pelo canal — sempre que uma
      oferta melhor aparece, a lista se atualiza sozinha.
    </p>

    {top5.length === 0 ? (
      <div class="mt-10 rounded-2xl border border-line bg-panel p-8 text-center text-muted">
        Nenhuma oferta disponível no momento. Confira o
        <a href="https://t.me/int3ch" target="_blank" rel="noopener" class="text-brand-2 hover:text-brand transition-colors"> canal no Telegram</a>.
      </div>
    ) : (
      <div class="mt-10 space-y-4">
        {top5.map((o, i) => (
          <a href={o.link} target="_blank" rel="noopener sponsored"
             class="group flex items-center gap-4 rounded-2xl border border-line bg-panel p-4 hover:border-brand/50 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-brand-2/10 transition-all duration-300">
            <span class="shrink-0 w-12 h-12 rounded-xl bg-panel-2 flex items-center justify-center text-xl font-bold text-text">
              {medalhas[i]}
            </span>
            <div class="shrink-0 w-20 h-20 rounded-xl overflow-hidden bg-panel-2 relative">
              {o.imagem ? (
                <img src={o.imagem} alt={o.titulo} loading="lazy" referrerpolicy="no-referrer" class="w-full h-full object-cover"
                     onerror="this.closest('div').querySelector('.img-fallback').hidden=false; this.remove()" />
              ) : null}
              <div class="img-fallback absolute inset-0 flex items-center justify-center text-muted text-[10px] px-1 text-center" hidden={!!o.imagem}>
                Sem imagem
              </div>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-sm text-text font-semibold line-clamp-2 group-hover:text-brand-2 transition-colors">{o.titulo}</p>
              <div class="flex items-center gap-2 mt-1.5">
                <span class="text-base font-bold text-text">{o.preco}</span>
                {o.precoOriginal ? <span class="text-xs text-muted line-through">{o.precoOriginal}</span> : null}
              </div>
            </div>
            <span class="shrink-0 rounded-full bg-gradient-to-r from-brand to-brand-2 text-black text-sm font-bold px-3 py-1.5">
              -{o.desconto}%
            </span>
          </a>
        ))}
      </div>
    )}

    <div class="mt-12">
      <TelegramCTA variant="banner" texto="Quer ver as ofertas assim que elas saem, antes de virarem top 5? Entra no canal." />
    </div>
  </section>
</BaseLayout>
