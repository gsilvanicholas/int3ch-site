---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TelegramCTA from '../../components/TelegramCTA.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="max-w-2xl mx-auto px-4 sm:px-6 py-14">
    <p class="text-xs text-muted mb-2">{post.data.pubDate.toLocaleDateString('pt-BR')}</p>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white leading-tight">{post.data.title}</h1>
    <p class="text-muted text-lg mt-4">{post.data.description}</p>

    <div class="prose prose-invert prose-headings:text-white prose-a:text-brand-2 mt-10 max-w-none">
      <Content />
    </div>

    <div class="mt-14">
      <TelegramCTA variant="banner" />
    </div>
  </article>
</BaseLayout>
