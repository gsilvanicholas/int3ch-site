---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import TelegramCTA from '../../components/TelegramCTA.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getEntry, render } from 'astro:content';
import { coverClara } from '../../lib/posts';
import ShareButtons from '../../components/ShareButtons.astro';

const { slug } = Astro.params;
const post = slug ? await getEntry('blog', slug) : undefined;

if (!post || post.data.pubDate > new Date()) {
  return Astro.rewrite('/404');
}

const { Content } = await render(post);
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <Breadcrumbs itens={[{ nome: 'Início', href: '/' }, { nome: 'Blog', href: '/blog' }, { nome: post.data.title }]} maxWidth="max-w-2xl" />
  <article class="max-w-2xl mx-auto px-4 sm:px-6 pt-6 pb-14">
    <p class="text-xs text-muted mb-2">{post.data.pubDate.toLocaleDateString('pt-BR')}</p>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text leading-tight">{post.data.title}</h1>
    <p class="text-muted text-lg mt-4">{post.data.description}</p>

    <div class="mt-5">
      <ShareButtons titulo={post.data.title} />
    </div>

    {post.data.cover && (
      <div class="mt-8 rounded-2xl overflow-hidden border border-line">
        <img src={post.data.cover} alt="" class="cover-dark w-full h-auto" />
        <img src={coverClara(post.data.cover)} alt="" class="cover-light w-full h-auto" />
      </div>
    )}

    <div class="prose prose-theme mt-10 max-w-none">
      <Content />
    </div>

    <div class="mt-14">
      <TelegramCTA variant="banner" />
    </div>
  </article>
</BaseLayout>
