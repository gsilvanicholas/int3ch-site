---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import TelegramCTA from '../../components/TelegramCTA.astro';
import OfertasRelacionadas from '../../components/OfertasRelacionadas.astro';
import FAQ from '../../components/FAQ.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const perguntas = [
  {
    pergunta: 'DPI mais alto é sinônimo de mouse melhor?',
    resposta: 'Não. A maioria dos jogadores usa entre 400 e 1600 DPI na prática — mouses anunciando 20.000+ DPI raramente são usados nessa faixa. O que separa um sensor bom de um ruim é a consistência e o tracking, não o número máximo na caixa.',
  },
  {
    pergunta: 'Mouse sem fio tem lag perceptível em jogos competitivos?',
    resposta: 'Modelos com sensor topo de linha e conexão 2.4GHz dedicada (não Bluetooth) têm resposta equivalente à de um mouse com fio hoje em dia. Bluetooth puro ainda pode introduzir latência perceptível em jogos mais exigentes.',
  },
  {
    pergunta: 'Peso do mouse importa mesmo?',
    resposta: 'Sim, principalmente em sessões longas ou jogos competitivos. Entre 70g e 90g já ajuda a reduzir fadiga no pulso; nos modelos ultraleves competitivos, o peso costuma ficar abaixo de 60g.',
  },
  {
    pergunta: 'Vale a pena pagar mais por um sensor "de verdade"?',
    resposta: 'Sim, se você joga com frequência. Sensores como PixArt PAW3311/3325 (intermediários) ou PAW3395/3950 (topo) evitam problemas como "spin outs" em movimentos rápidos, o que sensores genéricos de entrada costumam sofrer.',
  },
];

const tipos = [
  {
    nome: 'Entrada (até R$60)',
    para: 'Uso geral, escritório home office, jogos casuais',
    olhar: ['Sensor óptico simples (1000-3200 DPI)', 'Fio USB (mais barato e sem lag)', 'Peso não costuma ser prioridade aqui'],
  },
  {
    nome: 'Intermediário (R$60-R$150)',
    para: 'FPS competitivo casual, MOBA, uso diário intenso',
    olhar: ['Sensor óptico de verdade (PixArt PAW3311/3325 ou equivalente)', 'Polling rate 1000Hz', 'Peso entre 70g-90g já ajuda no pulso'],
  },
  {
    nome: 'Competitivo (R$150+)',
    para: 'FPS sério, quem joga ranked com frequência',
    olhar: ['Sensor topo de linha (PAW3395, PAW3950)', 'Sem fio com resposta equivalente a com fio (2.4GHz dedicado)', 'Peso abaixo de 60g nos modelos ultraleves'],
  },
];
---
<BaseLayout
  title="Melhores Mouses Gamer: Guia de Compra 2026"
  description="Como escolher um mouse gamer sem gastar mais do que precisa - sensor, DPI, peso e faixas de preço explicadas."
>
  <Breadcrumbs itens={[{ nome: 'Início', href: '/' }, { nome: 'Guias', href: '/guias' }, { nome: 'Mouses Gamer' }]} />
  <section class="max-w-3xl mx-auto px-4 sm:px-6 pt-6 pb-14">
    <p class="text-brand-2 font-semibold uppercase text-sm tracking-wide mb-3">Guia de compra</p>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text leading-tight">Melhores Mouses Gamer: o que realmente importa</h1>
    <p class="text-muted text-lg mt-4">
      Marketing de mouse gamer adora empilhar número de DPI. Na prática, isso quase nunca é o que faz diferença no seu jogo.
      Aqui está o que olhar de verdade, por faixa de orçamento.
    </p>

    <div class="mt-10 space-y-6">
      {tipos.map((t) => (
        <div class="rounded-2xl border border-line bg-panel p-6">
          <div class="flex items-baseline justify-between flex-wrap gap-2">
            <h2 class="text-xl font-bold text-text">{t.nome}</h2>
            <span class="text-muted text-sm">{t.para}</span>
          </div>
          <ul class="mt-4 space-y-2">
            {t.olhar.map((item) => (
              <li class="text-sm text-muted flex gap-2">
                <span class="text-brand-2">✓</span> {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 rounded-2xl border border-line bg-panel p-6">
      <h2 class="text-xl font-bold text-text">DPI alto não é sinônimo de mouse melhor</h2>
      <p class="text-muted text-sm mt-3 leading-relaxed">
        A maioria dos jogadores usa entre 400 e 1600 DPI na prática — mouses anunciando 20.000+ DPI raramente são
        usados nessa faixa real. O que separa um sensor bom de um ruim é a <strong class="text-text">consistência</strong>
        (sem "spin outs" em movimentos rápidos) e o <strong class="text-text">tracking</strong>, não o número máximo na caixa.
      </p>
    </div>

    <OfertasRelacionadas
      titulo="Mouses em oferta agora"
      termos={['mouse']}
      excluir={['ipad', 'tablet', 'notebook', 'monitor']}
    />

    <FAQ perguntas={perguntas} />

    <div class="mt-12">
      <TelegramCTA variant="banner" texto="Acompanhamos o preço de mouses gamer todo dia — entre no canal pra pegar quando o seu modelo entrar em promoção de verdade." />
    </div>
  </section>
</BaseLayout>
