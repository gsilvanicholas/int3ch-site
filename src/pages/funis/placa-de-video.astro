---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import TelegramCTA from '../../components/TelegramCTA.astro';
import OfertasRelacionadas from '../../components/OfertasRelacionadas.astro';
import FAQ from '../../components/FAQ.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ShareButtons from '../../components/ShareButtons.astro';

const perguntas = [
  {
    pergunta: 'Quanto de VRAM eu preciso, na prática?',
    resposta: '8GB é o mínimo confortável para jogar em 1080p hoje. Para 1440p, prefira 12GB. Para 4K ou jogos muito pesados com texturas em qualidade máxima, 16GB ou mais evita perda de desempenho por falta de memória.',
  },
  {
    pergunta: 'Vale a pena pagar mais por ray tracing?',
    resposta: 'Só se você joga títulos que suportam bem a tecnologia e sua placa tem upscaling (DLSS/FSR) para compensar a perda de desempenho. Em faixas de entrada, o ray tracing costuma ser pouco utilizável na prática.',
  },
  {
    pergunta: 'Minha fonte de alimentação aguenta a placa nova?',
    resposta: 'Confira o consumo recomendado pelo fabricante (normalmente informado na página do produto) e compare com a potência real da sua fonte, não só o valor impresso. Placas de faixa alta costumam exigir fontes de 750W ou mais.',
  },
  {
    pergunta: 'GPU forte com processador fraco funciona bem?',
    resposta: 'Não necessariamente — um processador abaixo do necessário cria gargalo e impede a placa de entregar todo o FPS que ela é capaz de gerar. Vale equilibrar as duas peças, especialmente em resoluções mais baixas.',
  },
];

const faixas = [
  {
    nome: 'Full HD (1080p)',
    para: 'Jogar em 1080p com boa taxa de quadros, sem gastar demais',
    olhar: ['8GB de VRAM já é confortável pra maioria dos jogos atuais', 'Não vale pagar a mais por 4K se você não vai usar 4K', 'Boa opção pra quem tem monitor 144Hz e quer aproveitar de verdade'],
  },
  {
    nome: '1440p (2K)',
    para: 'O equilíbrio entre nitidez e desempenho pra quem já tem monitor 1440p',
    olhar: ['12GB de VRAM evita gargalo em texturas altas', 'Ray tracing começa a fazer sentido aqui, com upscaling (DLSS/FSR) ligado', 'Verifique se sua fonte suporta o consumo — GPUs dessa faixa consomem mais'],
  },
  {
    nome: '4K / topo de linha',
    para: 'Quem quer o máximo, sem economizar',
    olhar: ['16GB+ de VRAM pra não virar gargalo em alguns jogos mais pesados', 'Exige processador forte junto — GPU boa com CPU fraca também trava frame', 'Fonte robusta (750W+) e boa ventilação no gabinete'],
  },
];
---
<BaseLayout
  title="Como Escolher uma Placa de Vídeo: Guia de Compra 2026"
  description="VRAM, resolucao e ray tracing explicados de forma pratica, por faixa de uso e orcamento."
>
  <Breadcrumbs itens={[{ nome: 'Início', href: '/' }, { nome: 'Guias', href: '/guias' }, { nome: 'Placa de Vídeo' }]} />
  <section class="max-w-3xl mx-auto px-4 sm:px-6 pt-6 pb-14">
    <p class="text-brand-2 font-semibold uppercase text-sm tracking-wide mb-3">Guia de compra</p>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text leading-tight">Como Escolher uma Placa de Vídeo</h1>
    <p class="text-muted text-lg mt-4">
      A pergunta certa não é "qual a mais forte que cabe no meu orçamento" — é "qual resolução eu realmente uso".
      Escolher pela resolução do seu monitor evita pagar por poder que você nunca vai aproveitar.
    </p>

    <div class="mt-5">
      <ShareButtons titulo="Como Escolher uma Placa de Vídeo" />
    </div>

    <div class="mt-10 space-y-6">
      {faixas.map((f) => (
        <div class="rounded-2xl border border-line bg-panel p-6">
          <div class="flex items-baseline justify-between flex-wrap gap-2">
            <h2 class="text-xl font-bold text-text">{f.nome}</h2>
            <span class="text-muted text-sm">{f.para}</span>
          </div>
          <ul class="mt-4 space-y-2">
            {f.olhar.map((item) => (
              <li class="text-sm text-muted flex gap-2">
                <span class="text-brand-2">✓</span> {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 rounded-2xl border border-brand/30 bg-gradient-to-br from-panel to-panel-2 p-6">
      <h2 class="text-xl font-bold text-text">VRAM não é só número de marketing</h2>
      <p class="text-muted text-sm mt-3 leading-relaxed">
        Memória de vídeo insuficiente causa quedas bruscas de FPS em texturas altas, mesmo que a GPU em si seja
        potente. Antes de comparar só o "poder bruto" entre modelos, confira se a VRAM é adequada pra resolução
        e qualidade gráfica que você pretende usar — é um dos erros mais comuns na hora de comprar.
      </p>
    </div>

    <OfertasRelacionadas
      titulo="Placas de vídeo em oferta agora"
      termos={['placa de vídeo', 'placa de video', ' gpu ', 'rtx', 'gtx', 'radeon', 'geforce']}
      excluir={['suporte', 'backplate', 'cabo', 'adaptador', 'capa']}
    />

    <FAQ perguntas={perguntas} />

    <div class="mt-12">
      <TelegramCTA variant="banner" texto="Placa de vídeo boa em promoção não dura — entre no canal pra não perder." />
    </div>
  </section>
</BaseLayout>
