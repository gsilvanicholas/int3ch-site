---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';

interface Oferta {
  id: string;
  titulo: string;
  preco: string;
  precoOriginal: string;
  desconto: number;
  imagem: string;
  link: string;
}

let ofertas: Oferta[] = [];
let erro = false;

try {
  const resp = await fetch(
    'https://raw.githubusercontent.com/gsilvanicholas/int3ch-site/master/data/ofertas.json',
    { cache: 'no-store' }
  );
  if (resp.ok) {
    ofertas = await resp.json();
  } else {
    erro = true;
  }
} catch {
  erro = true;
}
---
<BaseLayout
  title="Ofertas"
  description="Ofertas de hardware e tecnologia atualizadas automaticamente, com desconto confiavel e sem produto replica."
>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-14">
    <h1 class="text-3xl font-extrabold text-white mb-2">Ofertas</h1>
    <p class="text-muted mb-8">
      Atualizado automaticamente a cada ciclo do canal — mesmos critérios de qualidade: desconto entre 25%-70%,
      nota alta e sem sinal de réplica.
    </p>

    {erro || ofertas.length === 0 ? (
      <div class="rounded-2xl border border-line bg-panel p-8 text-center text-muted">
        Nenhuma oferta disponível no momento. Volte em breve ou confira o
        <a href="https://t.me/int3ch" target="_blank" rel="noopener" class="text-brand-2 hover:text-brand transition-colors"> canal no Telegram</a>.
      </div>
    ) : (
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        {ofertas.map((o) => (
          <a href={o.link} target="_blank" rel="noopener sponsored"
             class="group relative rounded-2xl border border-line bg-panel overflow-hidden aspect-square hover:border-brand/50 hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-2/10 transition-all duration-300">
            <img src={o.imagem} alt={o.titulo} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/10 to-transparent" />
            <span class="absolute top-2.5 left-2.5 rounded-full bg-gradient-to-r from-brand to-brand-2 text-black text-xs font-bold px-2.5 py-1">
              -{o.desconto}%
            </span>
            <div class="absolute bottom-0 left-0 right-0 p-3">
              <p class="text-xs text-white/90 line-clamp-2 group-hover:text-white transition-colors">{o.titulo}</p>
              <p class="text-sm font-bold text-white mt-1">{o.preco}</p>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
