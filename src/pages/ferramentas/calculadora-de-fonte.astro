---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import TelegramCTA from '../../components/TelegramCTA.astro';
---
<BaseLayout
  title="Calculadora de Fonte: Quantos Watts Meu PC Precisa?"
  description="Calculadora gratuita de potencia de fonte para PC. Informe seus componentes e descubra quantos watts sua fonte precisa ter, com margem de seguranca."
>
  <Breadcrumbs itens={[{ nome: 'Início', href: '/' }, { nome: 'Ferramentas' }, { nome: 'Calculadora de Fonte' }]} />
  <section class="max-w-3xl mx-auto px-4 sm:px-6 pt-6 pb-14">
    <p class="text-brand-2 font-semibold uppercase text-sm tracking-wide mb-3">Ferramenta</p>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text leading-tight">Calculadora de Fonte</h1>
    <p class="text-muted text-lg mt-4">
      Informe os componentes do seu PC e veja quantos watts sua fonte precisa ter, já com margem de segurança.
      Mais de 60 modelos de processador e placa de vídeo pra você escolher o mais próximo do seu setup.
    </p>

    <div class="mt-5">
      <ShareButtons titulo="Calculadora de Fonte: Quantos Watts Meu PC Precisa?" />
    </div>

    <div class="mt-10 rounded-2xl border border-line bg-panel p-6 sm:p-8">
      <div class="grid sm:grid-cols-2 gap-6">
        <label class="block">
          <span class="text-sm font-semibold text-text">Processador</span>
          <select id="cpu" class="mt-2 w-full rounded-lg border border-line bg-panel-2 text-text px-3 py-2.5 text-sm">
            <optgroup label="AMD Ryzen (AM4)">
              <option value="65">Ryzen 3 3200G — ~65W</option>
              <option value="65">Ryzen 5 3400G — ~65W</option>
              <option value="88">Ryzen 5 3600 — ~88W</option>
              <option value="88">Ryzen 7 3700X — ~88W</option>
              <option value="142">Ryzen 9 3900X — ~142W</option>
              <option value="65">Ryzen 3 4100 — ~65W</option>
              <option value="65">Ryzen 5 5500 — ~65W</option>
              <option value="65">Ryzen 5 5600G — ~65W</option>
              <option value="76">Ryzen 5 5600 — ~76W</option>
              <option value="88" selected>Ryzen 5 5600X — ~88W</option>
              <option value="65">Ryzen 7 5700G — ~65W</option>
              <option value="88">Ryzen 7 5700X — ~88W</option>
              <option value="142">Ryzen 7 5800X — ~142W</option>
              <option value="142">Ryzen 7 5800X3D — ~142W</option>
              <option value="142">Ryzen 9 5900X — ~142W</option>
              <option value="142">Ryzen 9 5950X — ~142W</option>
            </optgroup>
            <optgroup label="AMD Ryzen (AM5)">
              <option value="65">Ryzen 5 7500F — ~65W</option>
              <option value="65">Ryzen 5 8600G — ~65W</option>
              <option value="88">Ryzen 5 7600 — ~88W</option>
              <option value="105">Ryzen 5 7600X — ~105W</option>
              <option value="88">Ryzen 7 7700 — ~88W</option>
              <option value="142">Ryzen 7 7700X — ~142W</option>
              <option value="120">Ryzen 7 7800X3D — ~120W</option>
              <option value="88">Ryzen 9 7900 — ~88W</option>
              <option value="170">Ryzen 9 7900X — ~170W</option>
              <option value="120">Ryzen 9 7900X3D — ~120W</option>
              <option value="230">Ryzen 9 7950X — ~230W</option>
              <option value="144">Ryzen 9 7950X3D — ~144W</option>
              <option value="170">Ryzen 9 9950X — ~170W</option>
            </optgroup>
            <optgroup label="Intel (10ª-11ª geração)">
              <option value="65">Core i3-10100F — ~65W</option>
              <option value="65">Core i5-10400F — ~65W</option>
              <option value="65">Core i5-11400F — ~65W</option>
              <option value="65">Core i7-10700F — ~65W</option>
              <option value="65">Core i7-11700F — ~65W</option>
            </optgroup>
            <optgroup label="Intel (12ª-14ª geração)">
              <option value="89">Core i3-12100F — ~89W</option>
              <option value="117">Core i5-12400F — ~117W</option>
              <option value="150">Core i5-12600K — ~150W</option>
              <option value="148">Core i5-13400F — ~148W</option>
              <option value="181">Core i5-13600K — ~181W</option>
              <option value="181">Core i5-14600K — ~181W</option>
              <option value="190">Core i7-12700F — ~190W</option>
              <option value="219">Core i7-13700F — ~219W</option>
              <option value="219">Core i7-14700F — ~219W</option>
              <option value="241">Core i9-12900K — ~241W</option>
              <option value="253">Core i9-13900F — ~253W</option>
              <option value="253">Core i9-14900F — ~253W</option>
            </optgroup>
          </select>
        </label>

        <label class="block">
          <span class="text-sm font-semibold text-text">Placa de vídeo</span>
          <select id="gpu" class="mt-2 w-full rounded-lg border border-line bg-panel-2 text-text px-3 py-2.5 text-sm">
            <option value="0">Sem placa dedicada (vídeo integrado)</option>
            <optgroup label="NVIDIA GTX (10/16 série)">
              <option value="30">GT 1030 — ~30W</option>
              <option value="75">GTX 1050 Ti — ~75W</option>
              <option value="120">GTX 1060 — ~120W</option>
              <option value="75">GTX 1650 — ~75W</option>
              <option value="100">GTX 1650 Super — ~100W</option>
              <option value="120">GTX 1660 — ~120W</option>
              <option value="120">GTX 1660 Ti — ~120W</option>
              <option value="125">GTX 1660 Super — ~125W</option>
            </optgroup>
            <optgroup label="NVIDIA RTX 20/30 série">
              <option value="160">RTX 2060 — ~160W</option>
              <option value="175">RTX 2060 Super — ~175W</option>
              <option value="215">RTX 2070 Super — ~215W</option>
              <option value="250">RTX 2080 Super — ~250W</option>
              <option value="130">RTX 3050 — ~130W</option>
              <option value="170">RTX 3060 — ~170W</option>
              <option value="200">RTX 3060 Ti — ~200W</option>
              <option value="220">RTX 3070 — ~220W</option>
              <option value="290">RTX 3070 Ti — ~290W</option>
              <option value="320">RTX 3080 — ~320W</option>
              <option value="350">RTX 3080 Ti — ~350W</option>
              <option value="350">RTX 3090 — ~350W</option>
            </optgroup>
            <optgroup label="NVIDIA RTX 40 série">
              <option value="115" selected>RTX 4060 — ~115W</option>
              <option value="160">RTX 4060 Ti — ~160W</option>
              <option value="165">RTX 4060 Ti 16GB — ~165W</option>
              <option value="200">RTX 4070 — ~200W</option>
              <option value="220">RTX 4070 Super — ~220W</option>
              <option value="285">RTX 4070 Ti — ~285W</option>
              <option value="285">RTX 4070 Ti Super — ~285W</option>
              <option value="320">RTX 4080 — ~320W</option>
              <option value="320">RTX 4080 Super — ~320W</option>
              <option value="450">RTX 4090 — ~450W</option>
            </optgroup>
            <optgroup label="AMD RX 500/5000 série">
              <option value="150">RX 570 — ~150W</option>
              <option value="185">RX 580 — ~185W</option>
              <option value="130">RX 5500 XT — ~130W</option>
              <option value="150">RX 5600 XT — ~150W</option>
              <option value="225">RX 5700 XT — ~225W</option>
            </optgroup>
            <optgroup label="AMD RX 6000 série">
              <option value="53">RX 6400 — ~53W</option>
              <option value="107">RX 6500 XT — ~107W</option>
              <option value="132">RX 6600 — ~132W</option>
              <option value="160">RX 6600 XT — ~160W</option>
              <option value="180">RX 6650 XT — ~180W</option>
              <option value="230">RX 6700 XT — ~230W</option>
              <option value="250">RX 6750 XT — ~250W</option>
              <option value="250">RX 6800 — ~250W</option>
              <option value="300">RX 6800 XT — ~300W</option>
              <option value="300">RX 6900 XT — ~300W</option>
              <option value="335">RX 6950 XT — ~335W</option>
            </optgroup>
            <optgroup label="AMD RX 7000 série">
              <option value="165">RX 7600 — ~165W</option>
              <option value="190">RX 7600 XT — ~190W</option>
              <option value="245">RX 7700 XT — ~245W</option>
              <option value="263">RX 7800 XT — ~263W</option>
              <option value="260">RX 7900 GRE — ~260W</option>
              <option value="315">RX 7900 XT — ~315W</option>
              <option value="355">RX 7900 XTX — ~355W</option>
            </optgroup>
          </select>
        </label>

        <label class="block">
          <span class="text-sm font-semibold text-text">Placa-mãe</span>
          <select id="mobo" class="mt-2 w-full rounded-lg border border-line bg-panel-2 text-text px-3 py-2.5 text-sm">
            <option value="30">Entrada (A320, H510, H610) — ~30W</option>
            <option value="45" selected>Intermediária (B450, B550, B660, B760) — ~45W</option>
            <option value="60">Topo de linha (X570, X670, Z690, Z790) — ~60W</option>
          </select>
        </label>

        <label class="block">
          <span class="text-sm font-semibold text-text">Memória RAM (por pente)</span>
          <select id="ram-spec" class="mt-2 w-full rounded-lg border border-line bg-panel-2 text-text px-3 py-2.5 text-sm">
            <optgroup label="DDR3">
              <option value="2">DDR3 4GB 1600MHz — ~2W</option>
              <option value="2.5">DDR3 8GB 1600MHz — ~2,5W</option>
            </optgroup>
            <optgroup label="DDR4">
              <option value="2">DDR4 4GB 2400MHz — ~2W</option>
              <option value="2.5">DDR4 8GB 2400MHz — ~2,5W</option>
              <option value="2.5">DDR4 8GB 2666MHz — ~2,5W</option>
              <option value="2.8">DDR4 8GB 3000MHz — ~2,8W</option>
              <option value="3" selected>DDR4 8GB 3200MHz — ~3W</option>
              <option value="3">DDR4 16GB 2666MHz — ~3W</option>
              <option value="3.3">DDR4 16GB 3000MHz — ~3,3W</option>
              <option value="3.5">DDR4 16GB 3200MHz — ~3,5W</option>
              <option value="4">DDR4 16GB 3600MHz — ~4W</option>
              <option value="5">DDR4 32GB 3200MHz — ~5W</option>
              <option value="5.5">DDR4 32GB 3600MHz — ~5,5W</option>
            </optgroup>
            <optgroup label="DDR5">
              <option value="3.5">DDR5 8GB 4800MHz — ~3,5W</option>
              <option value="4">DDR5 16GB 4800MHz — ~4W</option>
              <option value="4">DDR5 16GB 5200MHz — ~4W</option>
              <option value="4.2">DDR5 16GB 5600MHz — ~4,2W</option>
              <option value="4.5">DDR5 16GB 6000MHz — ~4,5W</option>
              <option value="4.8">DDR5 16GB 6400MHz — ~4,8W</option>
              <option value="5.5">DDR5 32GB 5600MHz — ~5,5W</option>
              <option value="6">DDR5 32GB 6000MHz — ~6W</option>
              <option value="6.5">DDR5 32GB 6400MHz — ~6,5W</option>
            </optgroup>
          </select>
        </label>

        <label class="block">
          <span class="text-sm font-semibold text-text">Quantidade de pentes</span>
          <input id="ram" type="number" min="0" max="8" value="2"
                 class="mt-2 w-full rounded-lg border border-line bg-panel-2 text-text px-3 py-2.5 text-sm" />
        </label>

        <label class="block">
          <span class="text-sm font-semibold text-text">Armazenamento (tipo)</span>
          <select id="storage-spec" class="mt-2 w-full rounded-lg border border-line bg-panel-2 text-text px-3 py-2.5 text-sm">
            <option value="3">SSD SATA — ~3W</option>
            <option value="6" selected>SSD NVMe — ~6W</option>
            <option value="4">HD 2.5" — ~4W</option>
            <option value="8">HD 3.5" 7200RPM — ~8W</option>
          </select>
        </label>

        <label class="block">
          <span class="text-sm font-semibold text-text">Quantidade de discos</span>
          <input id="storage" type="number" min="0" max="10" value="2"
                 class="mt-2 w-full rounded-lg border border-line bg-panel-2 text-text px-3 py-2.5 text-sm" />
        </label>

        <label class="block">
          <span class="text-sm font-semibold text-text">Ventoinhas do gabinete</span>
          <input id="fans" type="number" min="0" max="12" value="3"
                 class="mt-2 w-full rounded-lg border border-line bg-panel-2 text-text px-3 py-2.5 text-sm" />
        </label>

        <label class="flex items-center gap-2 mt-7">
          <input id="overclock" type="checkbox" class="w-4 h-4 accent-brand-2" />
          <span class="text-sm font-semibold text-text">Pretendo fazer overclock</span>
        </label>
      </div>

      <div id="resultado" class="mt-8 rounded-2xl border border-brand/30 bg-gradient-to-br from-panel to-panel-2 p-6 text-center">
        <p class="text-sm text-muted">Fonte recomendada</p>
        <p class="text-4xl font-extrabold text-text mt-1"><span id="watts-recomendado">550</span>W</p>
        <p class="text-xs text-muted mt-2">Consumo estimado: <span id="watts-base">0</span>W + margem de segurança</p>
      </div>
    </div>

    <div class="mt-10 rounded-2xl border border-line bg-panel p-6">
      <h2 class="text-lg font-bold text-text">Como calculamos</h2>
      <p class="text-muted text-sm mt-3 leading-relaxed">
        Somamos o consumo típico de cada componente — CPU e GPU pelo modelo escolhido, placa-mãe pela faixa de
        chipset, RAM conforme o tipo/frequência, armazenamento conforme o tipo de disco, ~3W por ventoinha — e
        aplicamos uma margem de
        segurança de 30% (40% com overclock marcado), que cobre picos de consumo momentâneos que a média não mostra.
        O resultado é arredondado pra cima, pro tamanho de fonte comercial mais próximo. Quer entender o raciocínio
        completo? <a href="/blog/como-calcular-fonte" class="text-brand-2 hover:text-brand transition-colors">Leia o guia de fonte</a>.
      </p>
    </div>

    <div class="mt-12">
      <TelegramCTA variant="banner" texto="Ofertas de fonte de alimentação também saem no canal — não perca." />
    </div>
  </section>
</BaseLayout>

<script>
  const TAMANHOS_COMERCIAIS = [450, 500, 550, 600, 650, 700, 750, 850, 1000, 1200];

  function arredondarParaTamanhoComercial(watts: number): number {
    for (const tamanho of TAMANHOS_COMERCIAIS) {
      if (tamanho >= watts) return tamanho;
    }
    return TAMANHOS_COMERCIAIS[TAMANHOS_COMERCIAIS.length - 1];
  }

  function calcular() {
    const cpu = document.getElementById('cpu') as HTMLSelectElement | null;
    const gpu = document.getElementById('gpu') as HTMLSelectElement | null;
    const mobo = document.getElementById('mobo') as HTMLSelectElement | null;
    const ramSpec = document.getElementById('ram-spec') as HTMLSelectElement | null;
    const ram = document.getElementById('ram') as HTMLInputElement | null;
    const storageSpec = document.getElementById('storage-spec') as HTMLSelectElement | null;
    const storage = document.getElementById('storage') as HTMLInputElement | null;
    const fans = document.getElementById('fans') as HTMLInputElement | null;
    const overclock = document.getElementById('overclock') as HTMLInputElement | null;
    if (!cpu || !gpu || !mobo || !ramSpec || !ram || !storageSpec || !storage || !fans || !overclock) return;

    const POR_FAN = 3;

    const base =
      Number(cpu.value) +
      Number(gpu.value) +
      Number(mobo.value) +
      Number(ram.value || 0) * Number(ramSpec.value) +
      Number(storage.value || 0) * Number(storageSpec.value) +
      Number(fans.value || 0) * POR_FAN;

    const margem = overclock.checked ? 1.4 : 1.3;
    const recomendado = arredondarParaTamanhoComercial(Math.ceil(base * margem));

    const elBase = document.getElementById('watts-base');
    const elRecomendado = document.getElementById('watts-recomendado');
    if (elBase) elBase.textContent = String(Math.round(base));
    if (elRecomendado) elRecomendado.textContent = String(recomendado);
  }

  function setup() {
    ['cpu', 'gpu', 'mobo', 'ram-spec', 'ram', 'storage-spec', 'storage', 'fans', 'overclock'].forEach((id) => {
      const el = document.getElementById(id);
      if (!el || el.hasAttribute('data-bound')) return;
      el.setAttribute('data-bound', 'true');
      el.addEventListener('input', calcular);
      el.addEventListener('change', calcular);
    });
    calcular();
  }

  setup();
  document.addEventListener('astro:page-load', setup);
</script>
