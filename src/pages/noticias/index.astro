---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getPublishedNoticias } from '../../lib/noticias';
import { coverClara } from '../../lib/posts';

const noticias = await getPublishedNoticias();
---
<BaseLayout title="Notícias" description="Notícias de tecnologia e hardware, direto das fontes, com contexto.">
  <Breadcrumbs itens={[{ nome: 'Início', href: '/' }, { nome: 'Notícias' }]} maxWidth="max-w-5xl" />
  <section class="max-w-5xl mx-auto px-4 sm:px-6 pt-6 pb-14">
    <h1 class="text-3xl font-extrabold text-text mb-8">Notícias</h1>
    <div class="grid sm:grid-cols-2 gap-5">
      {noticias.map((n) => (
        <a href={`/noticias/${n.id}`} class="group rounded-2xl border border-line bg-panel overflow-hidden hover:border-brand/50 hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-2/10 transition-all duration-300">
          {n.data.cover && (
            <div class="aspect-[16/9] bg-panel-2 overflow-hidden">
              <img src={n.data.cover} alt="" loading="lazy" class="cover-dark w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <img src={coverClara(n.data.cover)} alt="" loading="lazy" class="cover-light w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
          )}
          <div class="p-6">
            <p class="text-xs text-muted mb-2">{n.data.pubDate.toLocaleDateString('pt-BR')} · {n.data.fonteNome}</p>
            <h2 class="text-lg font-bold text-text group-hover:text-brand-2 transition-colors">{n.data.title}</h2>
            <p class="text-muted text-sm mt-2">{n.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
