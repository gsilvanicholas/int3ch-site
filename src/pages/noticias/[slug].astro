---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import TelegramCTA from '../../components/TelegramCTA.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getEntry, render } from 'astro:content';
import { coverClara } from '../../lib/posts';
import ShareButtons from '../../components/ShareButtons.astro';

const { slug } = Astro.params;
const noticia = slug ? await getEntry('noticias', slug) : undefined;

if (!noticia || noticia.data.pubDate > new Date()) {
  return Astro.rewrite('/404');
}

const { Content } = await render(noticia);
---
<BaseLayout title={noticia.data.title} description={noticia.data.description}>
  <Breadcrumbs itens={[{ nome: 'Início', href: '/' }, { nome: 'Notícias', href: '/noticias' }, { nome: noticia.data.title }]} maxWidth="max-w-2xl" />
  <article class="max-w-2xl mx-auto px-4 sm:px-6 pt-6 pb-14">
    <p class="text-xs text-muted mb-2">{noticia.data.pubDate.toLocaleDateString('pt-BR')}</p>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-text leading-tight">{noticia.data.title}</h1>
    <p class="text-muted text-lg mt-4">{noticia.data.description}</p>

    <div class="mt-5">
      <ShareButtons titulo={noticia.data.title} />
    </div>

    {noticia.data.cover && (
      <div class="mt-8 rounded-2xl overflow-hidden border border-line">
        <img src={noticia.data.cover} alt="" class="cover-dark w-full h-auto" />
        <img src={coverClara(noticia.data.cover)} alt="" class="cover-light w-full h-auto" />
      </div>
    )}

    <div class="prose prose-theme mt-10 max-w-none">
      <Content />
    </div>

    <p class="mt-8 text-sm text-muted">
      Fonte: <a href={noticia.data.fonteUrl} target="_blank" rel="noopener noreferrer" class="text-brand-2 hover:underline">{noticia.data.fonteNome}</a>
    </p>

    <div class="mt-14">
      <TelegramCTA variant="banner" />
    </div>
  </article>
</BaseLayout>
