---
import TelegramCTA from './TelegramCTA.astro';
---
<header class="border-b border-line/60 sticky top-0 z-40 backdrop-blur bg-ink/90">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center shrink-0">
      <img src="/logo.png" alt="iNT3CH" class="h-7 w-auto" />
    </a>
    <nav class="hidden sm:flex items-center gap-6 text-sm text-muted">
      <a href="/ofertas" class="hover:text-text transition-colors">Ofertas</a>
      <a href="/blog" class="hover:text-text transition-colors">Blog</a>
      <a href="/guias" class="hover:text-text transition-colors">Guias</a>
      <a href="/guias#ferramentas" class="relative hover:text-text transition-colors">
        Ferramentas
        <span class="absolute -top-1.5 -right-2.5 w-1.5 h-1.5 rounded-full bg-brand-2 animate-pulse"></span>
      </a>
      <a href="/sobre" class="hover:text-text transition-colors">Sobre</a>
    </nav>
    <div class="flex items-center gap-3">
      <button id="theme-toggle" type="button" aria-label="Alternar tema claro/escuro"
              class="p-2 rounded-lg text-muted hover:bg-panel hover:text-text transition-colors">
        <svg id="theme-icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
        <svg id="theme-icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
        </svg>
      </button>
      <div class="hidden sm:block">
        <TelegramCTA />
      </div>
      <details class="sm:hidden relative">
        <summary class="list-none cursor-pointer p-2 -mr-2 rounded-lg hover:bg-panel" aria-label="Abrir menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </summary>
        <div class="absolute right-0 top-12 w-52 rounded-xl border border-line bg-panel p-2 shadow-xl">
          <a href="/ofertas" class="block px-3 py-2 rounded-lg text-sm text-muted hover:bg-panel-2 hover:text-text transition-colors">Ofertas</a>
          <a href="/blog" class="block px-3 py-2 rounded-lg text-sm text-muted hover:bg-panel-2 hover:text-text transition-colors">Blog</a>
          <a href="/guias" class="block px-3 py-2 rounded-lg text-sm text-muted hover:bg-panel-2 hover:text-text transition-colors">Guias</a>
          <a href="/guias#ferramentas" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-muted hover:bg-panel-2 hover:text-text transition-colors">
            Ferramentas
            <span class="text-[10px] font-bold uppercase tracking-wide text-black bg-gradient-to-r from-brand to-brand-2 rounded-full px-1.5 py-0.5">Novo</span>
          </a>
          <a href="/sobre" class="block px-3 py-2 rounded-lg text-sm text-muted hover:bg-panel-2 hover:text-text transition-colors">Sobre</a>
          <a href="https://t.me/int3ch" target="_blank" rel="noopener"
             class="mt-1 flex items-center justify-center rounded-lg bg-gradient-to-r from-brand to-brand-2 px-3 py-2 text-sm font-semibold text-black">
            Ver ofertas no Telegram
          </a>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  function temaEfetivo() {
    const explicito = document.documentElement.dataset.theme;
    if (explicito === 'light' || explicito === 'dark') return explicito;
    return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
  }

  function syncThemeIcon() {
    const isLight = temaEfetivo() === 'light';
    document.getElementById('theme-icon-sun')?.classList.toggle('hidden', isLight);
    document.getElementById('theme-icon-moon')?.classList.toggle('hidden', !isLight);
  }

  function setupThemeToggle() {
    syncThemeIcon();
    const btn = document.getElementById('theme-toggle');
    btn?.addEventListener('click', () => {
      const proximo = temaEfetivo() === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = proximo;
      localStorage.setItem('theme', proximo);
      syncThemeIcon();
    });
  }

  document.addEventListener('astro:page-load', setupThemeToggle);
</script>
