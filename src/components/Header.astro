        <div class="absolute right-0 top-12 w-52 rounded-xl border border-line bg-panel p-2 shadow-xl">
          <a href="/ofertas" class="block px-3 py-2 rounded-lg text-sm text-muted hover:bg-panel-2 hover:text-text transition-colors">Ofertas</a>
          <a href="/noticias" class="block px-3 py-2 rounded-lg text-sm text-muted hover:bg-panel-2 hover:text-text transition-colors">Notícias</a>
          <a href="/blog" class="block px-3 py-2 rounded-lg text-sm text-muted hover:bg-panel-2 hover:text-text transition-colors">Blog</a>
          <a href="/guias" class="block px-3 py-2 rounded-lg text-sm text-muted hover:bg-panel-2 hover:text-text transition-colors">Guias</a>
          <a href="/guias#ferramentas" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-muted hover:bg-panel-2 hover:text-text transition-colors">
            Ferramentas
