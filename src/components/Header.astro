        </svg>
      </button>
      <div class="hidden sm:flex items-center rounded-full bg-gradient-to-r from-brand to-brand-2 overflow-hidden">
        <a href="https://whatsapp.com/channel/0029Vb93GE21yT2DF9VqwH3e" target="_blank" rel="noopener" aria-label="Canal no WhatsApp"
